# Copy to .env.local and fill in the values when connecting real services.

# Supabase (PostgreSQL / Auth / Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional AI provider (Listing Assistant, Image Assistant, Fraud Detection, Translation)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
